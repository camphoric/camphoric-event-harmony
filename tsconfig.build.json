{
  // Compiles the event to dist/ (JavaScript and declarations), starting from
  // index.ts so only what the event module imports is built (not its bulk
  // script or tests).
  "extends": "@camphoric/camphoric-event-import-spec/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "files": ["index.ts"]
}
